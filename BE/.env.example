APP_NAME="MediaMind API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Supabase
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key-placeholder"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-placeholder"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-placeholder"
SUPABASE_STORAGE_BUCKET="screenshots"

# Database
# For Supabase cloud: postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# For local dev fallback: sqlite:///./mediamind_dev.db
DATABASE_URL="sqlite:///./mediamind_dev.db"

# Runtime AI (Gemini)
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GEMINI_RUNTIME_MODEL="gemini-2.0-flash"
# Optional backward-compatible alias:
# GEMINI_MODEL_ID="gemini-2.5-flash"
GEMINI_PRICING_TIER="standard" # 'standard' (pay-as-you-go) or 'free' (Google AI Studio rate-limited tier)
GEMINI_PROMPT_VERSION="v1.0.0"

# Local Storage
LOCAL_STORAGE_PATH="./storage_data"

# CORS Origins (comma-separated list of allowed origins or JSON array)
# Note: *.vercel.app and localhost are already automatically permitted
BACKEND_CORS_ORIGINS="http://localhost:3000,https://your-custom-domain.com"

