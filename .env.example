# MediaMind Root Environment Configuration
# Copy this file to .env and configure real credentials for production or local deployment.

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_ANON_KEY=your-anon-key-placeholder

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Supabase Storage Bucket for original screenshots and derivative crops
SUPABASE_STORAGE_BUCKET=screenshots

# Supabase Database Direct Connection String (PostgreSQL)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediamind

# ==============================================================================
# Runtime AI Configuration (Gemini API)
# ==============================================================================
# Server-side only Gemini API key
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Gemini model identifier for multimodal processing (configurable runtime model)
# e.g. gemini-3.5-flash-lite, gemini-3.5-flash, gemini-3.1-flash-lite
GEMINI_RUNTIME_MODEL=gemini-3.5-flash-lite
# Optional backward-compatible alias:
# GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_PRICING_TIER=standard # 'standard' (pay-as-you-go) or 'free' (Google AI Studio rate-limited tier)

# Prompt version used for extraction traceability
GEMINI_PROMPT_VERSION=v1.0.0

# ==============================================================================
# External Metadata Provider Keys (Optional / Free Tier)
# ==============================================================================
# Google Books API Key (Optional: can run unauthenticated with lower quota limits)
GOOGLE_BOOKS_API_KEY=

# The Movie Database (TMDB) API Key (v3 auth)
TMDB_API_KEY=

# YouTube Data API v3 Key
YOUTUBE_API_KEY=

# Podcast Index API Credentials
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# ==============================================================================
# Application Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOCAL_STORAGE_PATH=./storage_data
